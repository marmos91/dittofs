#!/usr/bin/env bash
# dtc: run dt inside the Linux dev container.
#
#   dtc <dt command> [args]      e.g. dtc list, dtc run lint, dtc services status
#   dtc shell                    interactive shell in the same container
#   dtc shell -c 'CMD'           one command, e.g. dtc shell -c 'go test -run TestX ./pkg/y'
#   dtc build                    (re)build the image
#   dtc clean                    drop the image and its cache volumes
#
# The host needs only Docker and git, Docker Desktop or a Docker Engine, on amd64
# or arm64. The container is privileged on the Docker host's Linux kernel (its
# NFS/CIFS clients, root without sudo), gets the Docker socket (for the suites and
# services that start containers), and sees the checkout at the SAME path as the
# host, so any bind mount it asks Docker for resolves on the host too. Go caches
# live in Docker volumes.
#
# Networking: on Docker Desktop the container uses the bridge network and reaches
# the host, and the services it publishes, through host.docker.internal. On a Linux
# engine, ports published on 127.0.0.1 are reachable only from the host's own
# network namespace, so the container shares it (--network host). DT_DOCKER_NET=
# host|bridge overrides the choice.
#
# DTC_PLATFORM=linux/amd64 (or linux/arm64) builds and runs the other architecture's
# image under emulation, e.g. to check that the image builds and runs there.
set -euo pipefail  # runs under bash 3.2 too: guard empty arrays with ${a[@]+"${a[@]}"}

HARNESS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The checkout this harness lives in, unless DITTOFS_REPO points at another one.
REPO="${DITTOFS_REPO:-$(git -C "$HARNESS" rev-parse --show-toplevel 2>/dev/null || (cd "$HARNESS/../.." && pwd))}"
REPO="$(cd "$REPO" && pwd)"
PLATFORM="${DTC_PLATFORM:-}"
IMAGE="dittofs-dtc:go1.26${PLATFORM:+-${PLATFORM##*/}}"
DOCKERFILE="$HARNESS/docker/dev.Dockerfile"

die() { echo "[dtc] $*" >&2; exit 2; }
warn() { echo "[dtc] $*" >&2; }
docker info >/dev/null 2>&1 || die "Docker is not reachable. Start Docker Desktop, or the Docker daemon on Linux."

# The container bind-mounts host paths, so the daemon must see this file system.
endpoint="$(docker context inspect -f '{{.Endpoints.docker.Host}}' 2>/dev/null || echo "${DOCKER_HOST:-unix:///var/run/docker.sock}")"
[[ -n "${DOCKER_HOST:-}" ]] && endpoint="$DOCKER_HOST"
case "$endpoint" in
    unix://*|npipe://*) ;;
    *) die "the Docker daemon is remote ($endpoint): dtc bind-mounts local paths and needs a local daemon" ;;
esac

info_os="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null || true)"
security="$(docker info --format '{{.SecurityOptions}}' 2>/dev/null || true)"
desktop=false
[[ "$info_os" == *"Docker Desktop"* ]] && desktop=true
net="${DT_DOCKER_NET:-}"
if [[ -z "$net" ]]; then if $desktop; then net=bridge; else net=host; fi; fi
[[ "$security" == *rootless* ]] &&
    warn "rootless Docker: the container cannot mount NFS or CIFS, so the suites that mount fail here"

if [[ "${1:-}" == clean ]]; then
    [[ -z "$(docker ps -q --filter name=^dtc-)" ]] || die "a dtc container is running; stop it first"
    docker image rm "$IMAGE" >/dev/null 2>&1 || true
    docker volume rm dittofs-dtc-gomod dittofs-dtc-gobuild dittofs-dtc-lint >/dev/null 2>&1 || true
    echo "[dtc] removed $IMAGE and its cache volumes" >&2
    exit 0
fi

# Rebuild when the Dockerfile changed since the image was built.
want="$(shasum -a 256 "$DOCKERFILE" 2>/dev/null | cut -c1-16 || sha256sum "$DOCKERFILE" | cut -c1-16)"
have="$(docker image inspect -f '{{index .Config.Labels "dt.dockerfile"}}' "$IMAGE" 2>/dev/null || true)"
platform=()
[[ -n "$PLATFORM" ]] && platform=(--platform "$PLATFORM")
if [[ "${1:-}" == build || "$want" != "$have" ]]; then
    echo "[dtc] building $IMAGE (dockerfile $want${PLATFORM:+, $PLATFORM})" >&2
    docker build -q ${platform[@]+"${platform[@]}"} --label "dt.dockerfile=$want" -t "$IMAGE" -f "$DOCKERFILE" "$HARNESS/docker" >/dev/null
    [[ "${1:-}" == build ]] && exit 0
fi

tty=(-i)
[[ -t 0 && -t 1 ]] && tty=(-it)
name="dtc-$$-$RANDOM"

# Pass the harness's own knobs through, and, for a git hook run here, the
# variables git sets for it (paths are the same inside). Not GIT_EXEC_PATH:
# that is the host's git.
envs=(-e DITTOFS_REPO="$REPO" -e DT_CONTAINER_NAME="$name" -e DT_HOST_UID="$(id -u)" -e DT_HOST_GID="$(id -g)")
# The host's timezone, so log names and timestamps line up with logs written on the host.
tz="${TZ:-$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p' || true)}"
[[ -z "$tz" && -r /etc/timezone ]] && tz="$(cat /etc/timezone)"
[[ -n "$tz" ]] && envs+=(-e TZ="$tz")
while IFS='=' read -r k _; do
    [[ "$k" =~ ^(DT_|DITTOFS_E2E_|DITTOFS_SKIP_|DITTOFS_PREPUSH_)
        || "$k" =~ ^GIT_(DIR|WORK_TREE|INDEX_FILE|PREFIX|OBJECT_DIRECTORY|ALTERNATE_OBJECT_DIRECTORIES|QUARANTINE_PATH|AUTHOR_[A-Z]+|COMMITTER_[A-Z]+)$ ]] &&
        [[ ! "$k" =~ ^DT_(CONTAINER_NAME|HOST_UID|HOST_GID|HOSTNET|FIX_OWNER|GIT_DIR)$ ]] && envs+=(-e "$k")
done < <(env)

# The daemon's socket, as the daemon sees it: Docker Desktop resolves
# /var/run/docker.sock to its own; a Linux engine's is the context's unix socket
# (rootless: under $XDG_RUNTIME_DIR).
sock=/var/run/docker.sock
if ! $desktop && [[ "$endpoint" == unix://* ]]; then sock="${endpoint#unix://}"; fi
mounts=(-v "$REPO:$REPO" -v "$sock:/var/run/docker.sock"
    -v dittofs-dtc-gomod:/go/pkg/mod -v dittofs-dtc-gobuild:/root/.cache/go-build -v dittofs-dtc-lint:/root/.cache/golangci-lint)
# The harness itself, when it is not inside that checkout (DITTOFS_REPO elsewhere).
[[ "$HARNESS/" == "$REPO/"* ]] || mounts+=(-v "$HARNESS:$HARNESS")
# A worktree's .git file points into the main checkout's .git/worktrees.
gitdir="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [[ -f "$REPO/.git" && -n "$gitdir" && -d "$gitdir" ]]; then mounts+=(-v "$gitdir:$gitdir"); fi

netflags=()
if [[ "$net" == host ]]; then
    # The host's network: services on localhost, no forwarders. --hostname is left
    # out (older engines reject it with host networking). The host's kernel modules,
    # so modprobe works.
    netflags=(--network host)
    envs+=(-e DT_HOSTNET=1)
    [[ -d /lib/modules ]] && mounts+=(-v /lib/modules:/lib/modules:ro)
else
    netflags=(--hostname "$name")
    # Docker Desktop defines host.docker.internal itself; elsewhere map it explicitly.
    $desktop || netflags+=(--add-host=host.docker.internal:host-gateway)
fi
# A Linux engine keeps uid 0 on files written into bind mounts; hand them back to
# the caller when the run ends (dtc-entry.sh). Docker Desktop maps ownership.
if ! $desktop && [[ "$(uname -s)" == Linux ]]; then
    envs+=(-e DT_FIX_OWNER=1 -e "DT_GIT_DIR=$gitdir")
fi
secflags=()
[[ "$security" == *selinux* ]] && secflags=(--security-opt label=disable)

cmd=("$@")

exec docker run --rm "${tty[@]}" --privileged --init --name "$name" \
    ${platform[@]+"${platform[@]}"} "${netflags[@]}" ${secflags[@]+"${secflags[@]}"} \
    "${mounts[@]}" "${envs[@]}" -w "$REPO" \
    --entrypoint "$HARNESS/docker/dtc-entry.sh" "$IMAGE" ${cmd[@]+"${cmd[@]}"}
