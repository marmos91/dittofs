#!/bin/sh
# dt: DittoFS's test harness, built from this checkout and run from its root
# with the given arguments (docs/internals/rfc-test-harness.md, section 3). It
# builds rather than using go run, which turns every failing exit status into 1.
set -e
cd "$(dirname "$0")/../../.."
go build -o test/harness/.bin/dt ./cmd/dt
exec test/harness/.bin/dt "$@"
