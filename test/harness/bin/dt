#!/bin/sh
# dt: DittoFS's test harness, built from this checkout and run from its root
# with the given arguments. It builds rather than using go run, which turns
# every failing exit status into 1.
# A binary per platform, the dtc container's apart from the host's: the two
# share the checkout, and can share a platform.
set -e
cd "$(dirname "$0")/../../.."
bin="test/harness/.bin/$(uname -s)-$(uname -m)${DT_IN_CONTAINER:+-dtc}/dt"
go build -o "$bin" ./cmd/dt
exec "$bin" "$@"
