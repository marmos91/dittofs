{
  "_comment": [
    "Every conformance suite, described once. test/conformance/run.sh dispatches",
    "from this file, .github/workflows/conformance.yml builds its matrix from it,",
    "ci-health.yml derives the workflows it monitors from it, and",
    "test/conformance/check-docs.sh keeps the documentation tables honest against it.",
    "Adding a suite means adding an entry here, not a workflow plus four tables.",
    "",
    "JSON rather than YAML so GitHub Actions can fromJSON() it directly and the",
    "runner can read it with jq, which every runner and dev shell already has.",
    "",
    "Fields:",
    "  profiles       every storage profile the suite's runner accepts",
    "  variant        second axis (NFS minor version, SMB auth), or absent",
    "  known_failures blacklist path relative to test/; a string when there is one",
    "                 table, or an object keyed by variant value when a suite",
    "                 grades each variant against its own table. A value may",
    "                 be a list of tables graded together (a shared table plus",
    "                 a per-variant overlay); run.sh passes them to the suite",
    "                 in DITTOFS_KNOWN_FAILURES, colon-separated.",
    "  tiers          profiles to run per GitHub event, defaulting to \"defaults\";",
    "                 \"all\" means every profile the suite has",
    "  timeout_minutes  the CI job timeout for one cell of this suite",
    "  host_adapter   true when the suite provisions a dfs on the host's NFS",
    "                 adapter port, so a stale server there would grade it",
    "                 against the wrong build. Docker-only suites publish no",
    "                 host port and must not be failed by a listener on it.",
    "  steps          ordered steps. Each declares its own privilege need, per",
    "                 step on purpose: pynfs speaks NFSv4 itself and must stay",
    "                 runnable with no mount and no root, so nothing may hoist",
    "                 a root precondition to the whole run."
  ],

  "defaults": {
    "tiers": { "pull_request": "all", "push": "all", "schedule": "all" }
  },

  "suites": {
    "wpts": {
      "description": "Windows Protocol Test Suites FileServer BVT",
      "protocol": "SMB",
      "profiles": ["memory", "badger", "badger-s3"],
      "known_failures": "smb-conformance/KNOWN_FAILURES.md",
      "tiers": { "pull_request": ["memory", "badger-s3"] },
      "timeout_minutes": 30,
      "steps": [
        {
          "name": "run",
          "cmd": "smb-conformance/run.sh",
          "args": ["--profile", "{profile}", "--verbose"],
          "root": false
        }
      ]
    },

    "smbtorture": {
      "description": "Samba smbtorture SMB2/3 protocol suite",
      "protocol": "SMB",
      "profiles": ["memory", "badger"],
      "known_failures": "smb-conformance/smbtorture/KNOWN_FAILURES.md",
      "tiers": { "pull_request": ["memory", "badger"] },
      "timeout_minutes": 45,
      "steps": [
        {
          "name": "run",
          "cmd": "smb-conformance/smbtorture/run.sh",
          "args": ["--profile", "{profile}", "--verbose"],
          "root": false
        }
      ]
    },

    "pjdfstest": {
      "description": "pjdfstest POSIX filesystem semantics over NFS",
      "host_adapter": true,
      "protocol": "NFS",
      "profiles": ["memory", "badger", "badger-s3"],
      "variant": {
        "name": "nfs-version",
        "values": ["3", "4", "4.1"]
      },
      "known_failures": {
        "3": "posix/KNOWN_FAILURES.md",
        "4": "posix/KNOWN_FAILURES_V4.md",
        "4.1": "posix/KNOWN_FAILURES_V4.md"
      },
      "tiers": { "pull_request": ["memory", "badger-s3"] },
      "timeout_minutes": 60,
      "steps": [
        {
          "name": "setup",
          "cmd": "posix/setup-posix.sh",
          "args": ["{profile}", "--nfs-version", "{variant}"],
          "root": true
        },
        {
          "name": "run",
          "cmd": "posix/run-posix.sh",
          "args": ["--nfs-version", "{variant}", "--grade"],
          "root": true
        },
        {
          "name": "teardown",
          "cmd": "posix/teardown-posix.sh",
          "args": [],
          "root": true,
          "always": true
        }
      ]
    },

    "nfs-kerberos": {
      "description": "NFS sec=krb5 mount and Kerberos credential handling",
      "protocol": "NFS",
      "profiles": ["memory-kerberos"],
      "known_failures": null,
      "timeout_minutes": 30,
      "steps": [
        {
          "name": "run",
          "cmd": "nfs-conformance/run.sh",
          "args": ["--verbose"],
          "root": false
        }
      ]
    },

    "pynfs": {
      "description": "pynfs NFSv4.0/4.1 protocol conformance",
      "host_adapter": true,
      "protocol": "NFS",
      "profiles": ["memory", "badger", "badger-s3"],
      "variant": {
        "name": "minor-version",
        "values": ["4.0", "4.1"]
      },
      "known_failures": {
        "4.0": "nfs-conformance/pynfs/KNOWN_FAILURES_V40.md",
        "4.1": "nfs-conformance/pynfs/KNOWN_FAILURES_V41.md"
      },
      "tiers": { "pull_request": ["memory", "badger-s3"] },
      "timeout_minutes": 45,
      "steps": [
        {
          "name": "run",
          "cmd": "nfs-conformance/pynfs/run-pynfs.sh",
          "args": ["--profile", "{profile}", "--minor-version", "{variant}"],
          "root": false
        }
      ]
    },
    "cthon04": {
      "description": "Connectathon basic/general/special/lock over named NFS mount option sets",
      "host_adapter": true,
      "protocol": "NFS",
      "profiles": ["memory", "badger", "badger-s3"],
      "variant": {
        "name": "mount-options",
        "values": ["default", "v3", "v4.0", "v4.1", "v4.1-noac", "v4.1-smallio"]
      },
      "known_failures": {
        "default": "nfs-mount/cthon04/KNOWN_FAILURES.md",
        "v3": ["nfs-mount/cthon04/KNOWN_FAILURES.md", "nfs-mount/cthon04/KNOWN_FAILURES_V3.md"],
        "v4.0": "nfs-mount/cthon04/KNOWN_FAILURES.md",
        "v4.1": "nfs-mount/cthon04/KNOWN_FAILURES.md",
        "v4.1-noac": "nfs-mount/cthon04/KNOWN_FAILURES.md",
        "v4.1-smallio": "nfs-mount/cthon04/KNOWN_FAILURES.md"
      },
      "tiers": { "pull_request": ["memory"], "push": [] },
      "timeout_minutes": 30,
      "steps": [
        {
          "name": "setup",
          "cmd": "posix/setup-posix.sh",
          "args": ["{profile}", "--no-mount"],
          "root": true
        },
        {
          "name": "run",
          "cmd": "nfs-mount/cthon04/run.sh",
          "args": ["--variant", "{variant}"],
          "root": true
        },
        {
          "name": "teardown",
          "cmd": "posix/teardown-posix.sh",
          "args": [],
          "root": true,
          "always": true
        }
      ]
    },
    "nfstest": {
      "description": "NetApp nfstest modules over named NFS mount option sets",
      "host_adapter": true,
      "protocol": "NFS",
      "profiles": ["memory"],
      "variant": {
        "name": "mount-options",
        "values": ["default", "v3", "v4.0", "v4.1", "v4.1-noac", "v4.1-smallio"]
      },
      "known_failures": {
        "default": ["nfs-mount/nfstest/KNOWN_FAILURES.md", "nfs-mount/nfstest/KNOWN_FAILURES_V4.md"],
        "v3": ["nfs-mount/nfstest/KNOWN_FAILURES.md", "nfs-mount/nfstest/KNOWN_FAILURES_V3.md"],
        "v4.0": ["nfs-mount/nfstest/KNOWN_FAILURES.md", "nfs-mount/nfstest/KNOWN_FAILURES_V4.md", "nfs-mount/nfstest/KNOWN_FAILURES_V40.md"],
        "v4.1": ["nfs-mount/nfstest/KNOWN_FAILURES.md", "nfs-mount/nfstest/KNOWN_FAILURES_V4.md"],
        "v4.1-noac": ["nfs-mount/nfstest/KNOWN_FAILURES.md", "nfs-mount/nfstest/KNOWN_FAILURES_V4.md"],
        "v4.1-smallio": ["nfs-mount/nfstest/KNOWN_FAILURES.md", "nfs-mount/nfstest/KNOWN_FAILURES_V4.md"]
      },
      "tiers": { "pull_request": [], "push": [] },
      "timeout_minutes": 60,
      "steps": [
        {
          "name": "setup",
          "cmd": "posix/setup-posix.sh",
          "args": ["{profile}", "--no-mount"],
          "root": true
        },
        {
          "name": "run",
          "cmd": "nfs-mount/nfstest/run.sh",
          "args": ["--variant", "{variant}"],
          "root": true
        },
        {
          "name": "teardown",
          "cmd": "posix/teardown-posix.sh",
          "args": [],
          "root": true,
          "always": true
        }
      ]
    }
  },

  "_workflows_comment": [
    "The conformance workflows ci-health.yml monitors, file to display name.",
    "It reads the file names from here; the workflow_run trigger has to repeat",
    "the display names because a GitHub trigger cannot be computed."
  ],
  "workflows": {
    "conformance.yml": "Conformance Suites",
    "nfs-pynfs.yml": "NFS Protocol Conformance",
    "e2e-tests.yml": "E2E Tests"
  }
}
