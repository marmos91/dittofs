{
  "_comment": [
    "Every conformance suite, described once. test/conformance/run.sh dispatches",
    "from this file, .github/workflows/conformance.yml builds its matrix from it,",
    "ci-health.yml derives the workflows it monitors from it, and",
    "test/conformance/check-docs.sh keeps the documentation tables honest against it.",
    "Adding a suite means adding an entry here, not a workflow plus four tables.",
    "",
    "JSON rather than YAML so GitHub Actions can fromJSON() it directly and the",
    "runner can read it with jq, which every runner and dev shell already has.",
    "",
    "Fields:",
    "  runner_dir     suite root, relative to test/",
    "  profiles       every storage profile the suite's runner accepts",
    "  variant        second axis (NFS minor version, SMB auth), or absent",
    "  known_failures blacklist path relative to test/; a string when there is one",
    "                 table, or an object keyed by variant value when a suite",
    "                 grades each variant against its own table",
    "  tiers          profiles to run per GitHub event; \"all\" means every profile",
    "  steps          ordered steps. Each names its own privilege and mount needs;",
    "                 they are per step on purpose, because pynfs speaks NFSv4",
    "                 itself and must stay runnable with no mount and no root.",
    "  grader         script whose exit status is the NUMBER of new failures"
  ],

  "defaults": {
    "tiers": {
      "pull_request": "all",
      "push": "all",
      "schedule": "all",
      "workflow_dispatch": "all"
    }
  },

  "suites": {
    "wpts": {
      "description": "Windows Protocol Test Suites FileServer BVT",
      "protocol": "SMB",
      "runner_dir": "smb-conformance",
      "profiles": ["memory", "badger", "badger-s3", "postgres-s3"],
      "known_failures": "smb-conformance/KNOWN_FAILURES.md",
      "grader": "smb-conformance/parse-results.sh",
      "tiers": {
        "pull_request": ["memory", "postgres-s3"],
        "push": "all",
        "schedule": "all"
      },
      "timeout_minutes": 30,
      "steps": [
        {
          "name": "run",
          "cmd": "smb-conformance/run.sh",
          "args": ["--profile", "{profile}", "--verbose"],
          "root": false,
          "mount": false,
          "docker": true
        }
      ]
    },

    "smbtorture": {
      "description": "Samba smbtorture SMB2/3 protocol suite",
      "protocol": "SMB",
      "runner_dir": "smb-conformance/smbtorture",
      "profiles": ["memory", "badger", "sqlite", "postgres"],
      "known_failures": "smb-conformance/smbtorture/KNOWN_FAILURES.md",
      "grader": "smb-conformance/smbtorture/parse-results.sh",
      "tiers": {
        "pull_request": ["memory", "badger"],
        "push": "all",
        "schedule": "all"
      },
      "timeout_minutes": 45,
      "steps": [
        {
          "name": "run",
          "cmd": "smb-conformance/smbtorture/run.sh",
          "args": ["--profile", "{profile}", "--verbose"],
          "root": false,
          "mount": false,
          "docker": true
        }
      ]
    },

    "pjdfstest": {
      "description": "pjdfstest POSIX filesystem semantics over NFS",
      "protocol": "NFS",
      "runner_dir": "posix",
      "profiles": ["memory", "badger", "postgres", "postgres-s3"],
      "variant": {
        "name": "nfs-version",
        "values": ["3", "4", "4.1"]
      },
      "known_failures": {
        "3": "posix/KNOWN_FAILURES.md",
        "4": "posix/KNOWN_FAILURES_V4.md",
        "4.1": "posix/KNOWN_FAILURES_V4.md"
      },
      "grader": "posix/parse-results.sh",
      "tiers": {
        "pull_request": ["memory", "postgres-s3"],
        "push": "all",
        "schedule": "all"
      },
      "timeout_minutes": 60,
      "steps": [
        {
          "name": "setup",
          "cmd": "posix/setup-posix.sh",
          "args": ["{profile}", "--nfs-version", "{variant}"],
          "root": true,
          "mount": true,
          "docker": false
        },
        {
          "name": "run",
          "cmd": "posix/run-posix.sh",
          "args": ["--nfs-version", "{variant}"],
          "root": true,
          "mount": true,
          "docker": false
        },
        {
          "name": "teardown",
          "cmd": "posix/teardown-posix.sh",
          "args": [],
          "root": true,
          "mount": true,
          "docker": false,
          "always": true
        }
      ]
    },

    "nfs-kerberos": {
      "description": "NFS sec=krb5 mount and Kerberos credential handling",
      "protocol": "NFS",
      "runner_dir": "nfs-conformance",
      "profiles": ["memory-kerberos"],
      "known_failures": null,
      "grader": null,
      "tiers": {
        "pull_request": "all",
        "push": "all",
        "schedule": "all"
      },
      "timeout_minutes": 30,
      "steps": [
        {
          "name": "run",
          "cmd": "nfs-conformance/run.sh",
          "args": ["--verbose"],
          "root": false,
          "mount": false,
          "docker": true
        }
      ]
    },

    "pynfs": {
      "description": "pynfs NFSv4.0/4.1 protocol conformance",
      "protocol": "NFS",
      "runner_dir": "nfs-conformance/pynfs",
      "profiles": ["memory", "badger", "postgres", "postgres-s3"],
      "variant": {
        "name": "minor-version",
        "values": ["4.0", "4.1"]
      },
      "known_failures": {
        "4.0": "nfs-conformance/pynfs/KNOWN_FAILURES_V40.md",
        "4.1": "nfs-conformance/pynfs/KNOWN_FAILURES_V41.md"
      },
      "grader": "nfs-conformance/pynfs/parse-results.sh",
      "tiers": {
        "pull_request": ["memory", "postgres-s3"],
        "push": "all",
        "schedule": "all"
      },
      "timeout_minutes": 45,
      "steps": [
        {
          "name": "run",
          "cmd": "nfs-conformance/pynfs/run-pynfs.sh",
          "args": ["--profile", "{profile}", "--minor-version", "{variant}"],
          "root": false,
          "mount": false,
          "docker": false
        }
      ]
    }
  },

  "workflows": {
    "conformance.yml": "Conformance Suites",
    "e2e-tests.yml": "E2E Tests"
  }
}
