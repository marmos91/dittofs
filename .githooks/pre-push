#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook for DittoFS. Runs unit tests on packages that changed
# since the push base (origin/develop by default) so CI doesn't burn
# time on a trivially-broken branch.
#
# Skip entirely: git push --no-verify, or DITTOFS_SKIP_PREPUSH=1.
# DITTOFS_PREPUSH_TIMEOUT sets go test's -timeout (default 10m): the engine
# and runtime packages alone take minutes under -race, and the changed
# packages run in parallel.

if [ -n "${DITTOFS_SKIP_PREPUSH:-}" ]; then
    exit 0
fi

# $1 = remote name, $2 = remote URL. Stdin: "<local-ref> <local-sha> <remote-ref> <remote-sha>"
# We don't need per-ref granularity — use the working tree against origin/develop.
BASE_REF="${DITTOFS_PREPUSH_BASE:-origin/develop}"
if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
    echo "pre-push: $BASE_REF not found, skipping test selection" >&2
    exit 0
fi

CHANGED_GO=$(git diff --name-only "$BASE_REF"...HEAD -- '*.go' 2>/dev/null || true)
if [ -z "$CHANGED_GO" ]; then
    exit 0
fi

# Map changed files → unique package dirs.
PKGS=$(echo "$CHANGED_GO" | xargs -n1 dirname | sort -u | sed 's|^|./|')
if [ -z "$PKGS" ]; then
    exit 0
fi

# The operator is a separate Go module; root-relative package paths cannot
# be tested from the main module.
OPERATOR_DIR="k8s/dittofs-operator"
ROOT_PKGS=""
OPERATOR_PKGS=""
while IFS= read -r pkg; do
    case "$pkg" in
        "./$OPERATOR_DIR") OPERATOR_PKGS+=" ." ;;
        "./$OPERATOR_DIR/"*) OPERATOR_PKGS+=" ./${pkg#"./$OPERATOR_DIR/"}" ;;
        *) ROOT_PKGS+=" $pkg" ;;
    esac
done <<< "$PKGS"

test_packages() {
    local module="$1" packages="$2"
    # Go decides what is left to test: a package the branch deletes, or one
    # whose files all need a build tag (e2e, kerberos), has no files to build
    # and is dropped. One with errors stays, so go test reports them.
    # shellcheck disable=SC2086  # intentional word-splitting
    packages=$(cd "$module" && go list -e -f '{{if or .GoFiles .CgoFiles .TestGoFiles .XTestGoFiles .InvalidGoFiles}}{{.ImportPath}}{{end}}' $packages)
    [ -n "$packages" ] || return 0

    # shellcheck disable=SC2086  # intentional word-splitting
    if ! (cd "$module" && go test -short -race -timeout="${DITTOFS_PREPUSH_TIMEOUT:-10m}" $packages); then
        echo "" >&2
        echo "pre-push: tests failed on changed packages in $module. 'git push --no-verify' skips." >&2
        exit 1
    fi
}

test_packages . "$ROOT_PKGS"
test_packages "$OPERATOR_DIR" "$OPERATOR_PKGS"
