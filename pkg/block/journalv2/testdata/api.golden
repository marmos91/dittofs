package github.com/marmos91/dittofs/pkg/block/journalv2/internal/platform

var (
	ErrNoBarriers	= errors.New("journal: filesystem is mounted without cache flushes")

	ErrCopyOnWrite	= errors.New("journal: copy-on-write is not disabled for the directory")

	ErrNotSubvolumeRoot	= errors.New("journal: directory is not a subvolume root")
)

func Check(r Report) error

func OS(dir string) (storage.FS, error)

type Report struct {
	Barriers	bool

	CopyOnWrite	bool

	NoCoWSet	bool

	BtrfsSubvolumeRoot	bool

	ThinProvisioned	bool
}

func Probe(dir string) (Report, error)

package github.com/marmos91/dittofs/pkg/block/journalv2/internal/reclaim

package github.com/marmos91/dittofs/pkg/block/journalv2/internal/recovery

package github.com/marmos91/dittofs/pkg/block/journalv2/internal/segment

package github.com/marmos91/dittofs/pkg/block/journalv2/internal/storage

type FS interface {
	Create(name string) (File, error)

	Open(name string) (File, error)

	Rename(oldName, newName string) error

	Remove(name string) error

	List() ([]string, error)

	SyncDir() error
}

type File interface {
	ReadAt(p []byte, off int64) (n int, err error)

	ReadAtDirect(p []byte, off int64) (n int, err error)

	WriteAt(p []byte, off int64) (n int, err error)

	Allocate(off, n int64) error

	Sync() error

	Truncate(size int64) error

	Size() (int64, error)

	Close() error

	Name() string
}

