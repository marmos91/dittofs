# record.fill: 96-byte header, 21-byte payload, 3 bytes of zero padding to
# the next multiple of 8. No modification time: only a write carries one
# (RFC 28 section 2.3).
44 4a 52 31                 # [0,4)   magic "DJR1"
02                          # [4]     kind 2, fill
00 00 00                    # [5,8)   reserved
01 02 03 04 05 06 07 08     # [8,16)  segment id 0x0807060504030201
a0 a1 a2 a3 a4 a5 a6 a7     # [16,32) FileID 0xa0..0xaf
a8 a9 aa ab ac ad ae af
30 31 32 33 34 35 36 37     # [32,40) file offset 0x3736353433323130
15 00 00 00 00 00 00 00     # [40,48) length 21
50 51 52 53 54 55 56 57     # [48,56) sequence number 0x5756555453525150
00 00 00 00 00 00 00 00     # [56,64) version epoch, always zero in this format
60 61 62 63 64 65 66 67     # [64,72) version counter 0x6766656463626160
70 71 72 73                 # [72,76) share tag 0x73727170
48 49 4a 4b 4c 4d 4e 4f     # [76,84) synced-through offset 0x4f4e4d4c4b4a4948
20 cc 7b e1                 # [84,88) payload CRC32C of identity then the 21
                            #         payload bytes, 0xe17bcc20
d8 d9 da db                 # [88,92) own offset in its segment 0xdbdad9d8
b6 32 87 52                 # [92,96) header CRC32C of identity then [0,92), 0x528732b6
e0 e1 e2 e3                 # [96,117) payload bytes 0xe0..0xf4, 21 of them
e4 e5 e6 e7
e8 e9 ea eb
ec ed ee ef
f0 f1 f2 f3
f4
00 00 00                    # [117,120) zero padding, covered by no checksum
